{
  "expo": {
    "name": "OStudy",
    "slug": "oren-study",
    "version": "1.9.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orenstudy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "locales": {
      "en": "./locales/en.json",
      "pt-BR": "./locales/pt-BR.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "it": "./locales/it.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ostudy.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "OStudy needs access to your gallery so you can attach exercise photos to the chat.",
        "NSCameraUsageDescription": "OStudy needs access to your camera so you can take exercise photos directly in the chat."
      }
    },
    "android": {
      "package": "com.orenstudy.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "backgroundColor": "#F8FAFC"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "OStudy needs access to your gallery so you can attach exercise photos to the chat.",
          "cameraPermission": "OStudy needs access to your camera so you can take exercise photos directly in the chat.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-notifications",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "baseUrl": "/app",
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9056de90-ba0d-4d78-9672-39e08f61df80"
      }
    },
    "owner": "buildss"
  }
}
